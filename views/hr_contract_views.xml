<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit hr.contract form view to add Appraisal Template & Frequency -->
    <record id="hr_contract_view_form_inherit_infs_appraisal" model="ir.ui.view">
        <field name="name">hr.contract.form.inherit.infs.appraisal</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other']//group[@name='notes_group']" position="before">
                <group name="appraisal_settings" string="Appraisal Settings">
                    <field name="appraisal_template_id"
                        options="{'no_create_edit': True}"
                        placeholder="Select appraisal template for this contract..."/>
                    <label for="frequency" string="Appraisal Frequency"/>
                    <div class="o_row">
                        <field name="frequency" class="oe_inline" placeholder="e.g. 6"/>
                        <span>months (Leave empty/0 to use General Settings default)</span>
                    </div>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Optional tree view columns for contract list -->
    <record id="hr_contract_view_tree_inherit_infs_appraisal" model="ir.ui.view">
        <field name="name">hr.contract.tree.inherit.infs.appraisal</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="appraisal_template_id" optional="hide"/>
                <field name="frequency" string="Appraisal Freq (mo)" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
